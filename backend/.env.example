# Server
PORT=5000
NODE_ENV=development
# Allowed browser origin for CORS (the CRM frontend)
CLIENT_URL=http://localhost:4200
# Number of reverse proxies in front of this API (unset or 0 when direct).
# Required for correct client IPs in rate limiting when behind nginx/etc.
TRUST_PROXY=1

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/crm_db

# Authentication
# JWT_SECRET must be at least 32 characters. Generate one, never commit a real secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-characters
# Access token lifetime. Short-lived tokens limit stolen-token exposure
# (no refresh tokens are issued). Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=15m

# Rate limiting for /api/auth endpoints (per IP, per window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_FORGOT_MAX=5

# Password reset
# Lifetime of a password reset link in minutes (default 15). Reset tokens are
# single-use and stored only as a SHA-256 hash.
PASSWORD_RESET_TTL_MINUTES=15

# Seed the initial company + OWNER account (npm run seed:owner). NEVER commit
# real credentials to the repository.
SEED_COMPANY_NAME=My CRM
SEED_OWNER_NAME=Admin
SEED_OWNER_EMAIL=admin@example.com
SEED_OWNER_PASSWORD=admin@123
